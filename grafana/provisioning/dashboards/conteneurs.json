      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(time() - max by (name) (max_over_time(container_last_seen{name!=\"\", container_label_com_docker_compose_project=\"ynovm2grp1dockerkube\", container_label_com_docker_compose_service!~\"cadvisor|prometheus|grafana|uptime-kuma\", container_label_com_docker_compose_service=~\"$service\"}[24h])) < 60) or vector(0)",
