#!/bin/bash
# k8s-demarrage : rallume les 3 VM k3s puis la stack, dans l'ordre des dépendances
# (Vault, puis bases, puis applis), avec le nombre de copies noté par k8s-arret.

VMS="110 111 112"
ETAT=/var/lib/k8s-stack

kube() {
  local id
  for id in $VMS; do
    qm status "$id" 2>/dev/null | grep -q "status: running" || continue
    qm agent "$id" ping >/dev/null 2>&1 || continue
    qm guest exec "$id" --timeout 60 -- k3s kubectl "$@" 2>/dev/null | python3 -c '
import sys, json
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(1)
sys.stdout.write(d.get("out-data") or "")
sys.exit(d.get("exitcode") or 0)' && return 0
  done
  return 1
}
dit() { echo "$(date +%T) $*"; }
copies() { # nom -> copies notées (1 par défaut)
  r=$(awk -v n="$1" '$3 == n {print $4}' "$ETAT/replicas.txt" 2>/dev/null)
  echo "${r:-1}"
}
attendre_pret() { # ns type nom
  for i in $(seq 1 100); do
    want=$(kube -n "$1" get "$2" "$3" -o 'jsonpath={.spec.replicas}')
    ok=$(kube -n "$1" get "$2" "$3" -o 'jsonpath={.status.readyReplicas}')
    [ "${ok:-0}" -ge "${want:-1}" ] && return 0
    sleep 3
  done
  dit "  $1/$3 pas prêt après 5 min"
}

dit "démarrage des VM"
for id in $VMS; do qm status "$id" | grep -q running || qm start "$id"; done
for i in $(seq 1 60); do
  n=$(kube get nodes --no-headers 2>/dev/null | awk '$2 == "Ready"' | wc -l)
  [ "$n" = 3 ] && break
  sleep 5
done
dit "nœuds Ready : $n/3"
systemctl start k8s-fencing && dit "k8s-fencing relancé"

dit "1/3 Vault"
kube -n vault scale statefulset vault --replicas="$(copies vault)" >/dev/null
attendre_pret vault statefulset vault
for i in $(seq 1 40); do
  kube -n vault exec vault-0 -- vault status >/dev/null 2>&1 && break   # code 0 = déverrouillé
  sleep 3
done
dit "  Vault déverrouillé"

dit "2/3 bases MariaDB"
kube -n wordpress scale statefulset wordpress-db --replicas="$(copies wordpress-db)" >/dev/null
kube -n nextcloud scale statefulset nextcloud-db --replicas="$(copies nextcloud-db)" >/dev/null
attendre_pret wordpress statefulset wordpress-db
attendre_pret nextcloud statefulset nextcloud-db

dit "3/3 applications"
PROM=$(kube -n monitoring get prometheus -o 'jsonpath={.items[0].metadata.name}')
kube -n wordpress scale deployment wordpress --replicas="$(copies wordpress)" >/dev/null
kube -n nextcloud scale deployment nextcloud --replicas="$(copies nextcloud)" >/dev/null
kube -n monitoring scale deployment monitoring-grafana --replicas="$(copies monitoring-grafana)" >/dev/null
kube -n monitoring patch prometheus "$PROM" --type merge -p "{\"spec\":{\"replicas\":$(copies "$PROM")}}" >/dev/null
attendre_pret wordpress deployment wordpress
attendre_pret nextcloud deployment nextcloud
attendre_pret monitoring deployment monitoring-grafana
attendre_pret monitoring statefulset "prometheus-$PROM"
dit "stack démarrée"
kube get pods -A --no-headers | awk '$1 ~ /^(vault|wordpress|nextcloud|monitoring)$/ && $4 != "Running" && $4 != "Completed" {print "  pas prêt : "$1"/"$2" "$4}'
