            "uid": "prometheus"
          },
          "expr": "max by (pvc) ((longhorn_volume_robustness{state=\"healthy\"} == 1) * 1 or (longhorn_volume_robustness{state=\"degraded\"} == 1) * 2 or (longhorn_volume_robustness{state=\"faulted\"} == 1) * 3 or (longhorn_volume_robustness{state=\"unknown\"} == 1) * 0)",
