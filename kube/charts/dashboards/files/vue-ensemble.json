          {
            "matcher": {
              "id": "byName",
              "options": "metallb-system"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "MetalLB"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Mémoire par application",
      "description": "Mémoire vive utilisée, empilée : le haut de la courbe est le total pour le cluster (3 × 4 Go).",
